<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing: xUnit v3 on Microsoft Testing Platform, as in pdn-soundmodem, where these
         tests were written. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.2.0" />

    <!-- Dependencies -->
    <PackageVersion Include="M0LTE.Ofdm" Version="0.1.0" />

    <!-- Public-API lock -->
    <PackageVersion Include="PublicApiGenerator" Version="11.4.5" />
  </ItemGroup>

</Project>
